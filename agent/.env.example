NEAR_NETWORK=testnet                # testnet | mainnet
RAIL_CONTRACT=ageback.testnet       # where you deployed build/ageback.wasm

# agent that buys things
AGENT_ACCOUNT=agent.testnet
AGENT_PRIVATE_KEY=ed25519:...

# human that owns the agent and receives rebates
PAYOUT_ACCOUNT=human.testnet
PAYOUT_PRIVATE_KEY=ed25519:...

# demo merchant
MERCHANT_ACCOUNT=pizzeria.testnet
MERCHANT_PRIVATE_KEY=ed25519:...
